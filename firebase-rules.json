{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() == auth.uid",

        "players": {
          "$uid": {
            ".write": "auth != null && data.parent().parent().child('phase').exists() && (auth.uid == $uid || auth.uid == data.parent().parent().child('turnPlayerId').val() || auth.uid == data.parent().parent().child('hostId').val())",
            ".validate": "newData.hasChildren(['name'])",
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24" },
            "skipNext": { ".validate": "newData.isBoolean()" },
            "online":   { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "halves": {
              "red":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
              "blue":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
              "yellow": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
              "$other": { ".validate": false }
            },
            "full": {
              "red":    { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
              "blue":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
              "yellow": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },

        "code":      { ".validate": "newData.isString() && newData.val() == $code" },
        "hostId":    { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber()" },

        "phase": {
          ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val() || auth.uid == data.parent().child('blueAuthor').val())",
          ".validate": "newData.isString() && newData.val().matches(/^(lobby|idle|rolled-question|guessing|chance|everyone-red|right-neighbor|blue-compose|blue-guessing|blue-reveal|answer-round|finished)$/)"
        },
        "turnIndex":       { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())", ".validate": "newData.isNumber() && newData.val() >= 0" },
        "turnPlayerId":    { ".write": "auth != null && (auth.uid == data.val() || auth.uid == data.parent().child('hostId').val())", ".validate": "newData.isString()" },
        "direction":       { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())", ".validate": "newData.val() == 1 || newData.val() == -1" },
        "lastRolledColor": { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())" },
        "lastRoll":        { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())" },
        "pendingColor":    { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())" },
        "extraTurn":       { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())", ".validate": "newData.isBoolean()" },
        "currentCard":     { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val() || auth.uid == data.parent().child('blueAuthor').val())" },
        "blueAuthor":      { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())", ".validate": "newData.isString()" },
        "blueBeneficiary": { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())", ".validate": "newData.isString()" },
        "decks":           { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())" },
        "winnerId":        { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())" },
        "finalDone":       { ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())", ".validate": "newData.isBoolean()" },

        "round": {
          ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val() || auth.uid == data.child('current').val())"
        },

        "votes": {
          ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
          }
        },

        "tips": {
          ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && data.parent().parent().child('phase').val() == 'blue-compose'",
            ".validate": "newData.isString() && newData.val().length <= 80"
          }
        },

        "composeProgress": {
          ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val() || auth.uid == data.parent().child('blueAuthor').val())"
        },

        "awardColors": {
          ".write": "auth != null && (auth.uid == data.parent().child('turnPlayerId').val() || auth.uid == data.parent().child('hostId').val())",
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.isString() && newData.val().matches(/^(red|blue|yellow)$/)"
          }
        },

        "$other": { ".validate": false }
      }
    },
    "$other": { ".read": false, ".write": false }
  }
}
